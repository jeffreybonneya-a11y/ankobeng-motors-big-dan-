rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admins Collection
    match /admins/{userId} {
      allow read, write: if true;
    }

    // Public readable CMS collections & admin mutation access
    match /products/{productId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /heroSlides/{slideId} {
      allow read, write: if true;
    }

    match /homepageContent/{docId} {
      allow read, write: if true;
    }

    match /homepage/{docId} {
      allow read, write: if true;
    }

    match /businessInfo/{docId} {
      allow read, write: if true;
    }

    match /media/{mediaId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /about/{docId} {
      allow read, write: if true;
    }

    match /contact/{docId} {
      allow read, write: if true;
    }
  }
}
